generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  PLAYING
  BACKLOG
  COMPLETED
  ON_HOLD
  DROPPED
}

enum PlaythroughStatus {
  PLAYING
  COMPLETED
  ON_HOLD
  DROPPED
}

model Game {
  id          BigInt    @id @default(autoincrement())
  rawgId      Int       @unique @map("rawg_id")
  title       String
  developer   String?
  imageUrl    String?   @map("image_url")
  releaseDate DateTime? @map("release_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userGames UserGame[]

  @@map("games")
}

model Profile {
  id        String   @id @db.Uuid
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  username  String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userGames       UserGame[]
  userPreferences UserPreference?

  @@map("profiles")
}

model UserGame {
  id        BigInt     @id @default(autoincrement())
  userId    String     @map("user_id") @db.Uuid
  gameId    BigInt     @map("game_id")
  genre     String?
  status    GameStatus
  dateAdded DateTime   @map("date_added") @db.Date
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user        Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game               @relation(fields: [gameId], references: [id])
  platforms   UserGamePlatform[]
  playThrough Playthrough[]

  @@unique([userId, gameId])
  @@map("user_games")
}

model UserGamePlatform {
  id         BigInt   @id @default(autoincrement())
  userGameId BigInt   @map("user_game_id")
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")

  userGame     UserGame      @relation(fields: [userGameId], references: [id], onDelete: Cascade)
  playThroughs Playthrough[]

  @@unique([userGameId, platform])
  @@map("user_game_platforms")
}

model Playthrough {
  id                    BigInt            @id @default(autoincrement())
  userGameId            BigInt            @map("user_game_id")
  platform              String
  playthroughNumber     Int               @map("playthrough_number")
  status                PlaythroughStatus
  dateStarted           DateTime?         @map("date_started") @db.Date
  dateEnded             DateTime?         @map("date_ended") @db.Date
  hoursPlayed           Decimal?          @map("hours_played") @db.Decimal(7, 2)
  rating                Int?
  achievementsSupported Boolean           @default(false) @map("achievements_supported")
  achievementsCompleted Int               @default(0) @map("achievements_completed")
  achievementsTotal     Int               @default(0) @map("achievements_total")
  notes                 String?
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  userGame         UserGame         @relation(fields: [userGameId], references: [id], onDelete: Cascade)
  userGamePlatform UserGamePlatform @relation(fields: [userGameId, platform], references: [userGameId, platform], onDelete: Cascade)

  @@unique([userGameId, playthroughNumber])
  @@map("playthroughs")
}

model UserPreference {
  userId                   String   @id @map("user_id") @db.Uuid
  theme                    String   @default("dark")
  defaultPlatform          String?  @map("default_platform")
  emailNotifications       Boolean  @default(true) @map("email_notifications")
  privateProfile           Boolean  @default(false) @map("private_profile")
  showGamingActivity       Boolean  @default(true) @map("show_gaming_activity")
  achievementNotifications Boolean  @default(true) @map("achievement_notifications")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
